# =============================================================================
# SmartCycle frontend configuration
#
#   cp .env.example .env
#
# Only variables prefixed with VITE_ are exposed to the browser, and they are
# INLINED INTO THE BUNDLE AT BUILD TIME. Anything here is public - never put a
# secret, API key, password or token in this file.
#
# Development needs no configuration at all: in dev the app falls back to
# http://127.0.0.1:8000, so `npm run dev` works immediately.
# =============================================================================


# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT (default)
# -----------------------------------------------------------------------------
# Base URL of the FastAPI backend during development.
# Used automatically when running `npm run dev`; you normally do not need to
# set it, because development already defaults to http://127.0.0.1:8000.
VITE_API_URL=http://127.0.0.1:8000


# -----------------------------------------------------------------------------
# PRODUCTION BUILD
# -----------------------------------------------------------------------------
# Set this when you run `npm run build`, if the API is served from a different
# host than the built frontend:
#
#   VITE_API_URL=https://api.your-domain.example.com npm run build
#
# The value is baked into the bundle - changing it later requires a rebuild;
# there is no runtime override.
#
# If you leave it unset for a production build, API calls go to the SAME ORIGIN
# as the page, which is the correct behaviour when a reverse proxy serves both
# the SPA and the API from one host. In that case remember to allow that origin
# in the backend's CORS_ORIGIN_PRODUCTION.
#
# The two must agree: whatever you set here must also be permitted by the
# backend's CORS_ORIGIN_PRODUCTION, otherwise the browser will block the calls.
