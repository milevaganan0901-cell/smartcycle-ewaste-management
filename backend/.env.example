# =============================================================================
# SmartCycle backend configuration
#
#   cp .env.example .env
#
# then fill in the values marked REQUIRED and start the server. This file is
# loaded automatically at startup. Real environment variables always win over
# anything set here, so a container or platform can override any value without
# editing a file.
#
# NEVER commit a real .env. This example contains placeholders only.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED - authentication
# -----------------------------------------------------------------------------
# Secret used to sign JWT access tokens. There is no default and no fallback:
# the API starts without it but refuses to issue or accept any token (503),
# and logs a warning at startup.
#
# Generate one for local development:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# In production, supply this from the platform's secret store. Never a file in
# the repository, never a default.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Access-token lifetime in minutes. Default 480 (8 hours).
# Production should use a much shorter value once refresh tokens exist.
ACCESS_TOKEN_EXPIRE_MINUTES=480


# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
# "local" in development, "production" on a deployed host. Informational only:
# it is reported by the health endpoint and never changes behaviour.
ENVIRONMENT=local


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Local development (leave DATABASE_URL unset and use DATABASE_PATH instead).
DATABASE_PATH=smartcycle.db

# Cloud deployment (PostgreSQL). Set DATABASE_URL to the connection string your
# database provider gives you. It is passed through untouched, so a pasted
# `postgresql://...` string works with no editing. Leave DATABASE_PATH unset
# when DATABASE_URL is set, because DATABASE_URL wins.
#
# The username and password live in this environment variable only. They must
# never be hardcoded in source or committed.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASENAME?sslmode=require
#
# PRODUCTION NOTE: SQLite is a single-writer, file-based database. Most hosting
# platforms use an ephemeral filesystem, where a SQLite file is silently
# destroyed on every redeploy. Use a hosted PostgreSQL instance for any real
# deployment.


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Local frontend origins (http://localhost:5173 and http://127.0.0.1:5173) are
# built into the application already, so a fresh clone works with no CORS
# configuration. Set the production frontend origin here, including the scheme.
#
# The allowlist is always explicit. A wildcard is never used and is discarded
# with a warning, because the API sends credentials.
CORS_ORIGIN_PRODUCTION=

# Optional override of the whole allowlist. Comma-separated, no wildcards.
# Setting this REPLACES the built-in development origins, so include them if
# you still want local development to work.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# -----------------------------------------------------------------------------
# ML VALUATION - all optional, the app runs without any of them
# -----------------------------------------------------------------------------
# Relative paths are resolved against the backend/ directory, never the
# process working directory.
SMARTCYCLE_DATA_DIR=data

# Trained scikit-learn pipeline, produced by the MANUAL step:
#   python -m app.scripts.train_valuation_model
# The model is never retrained automatically, on startup or on request.
# If this file is missing or unreadable the API silently falls back to the
# rule-based estimator and labels the result "rule_based".
#
# On a free hosting tier the filesystem is usually wiped on every redeploy, so
# either run the training script as part of the platform's build command, or
# accept the rule-based fallback.
VALUATION_MODEL_PATH=data/valuation_model.joblib

# Metrics sidecar written by the training script, shown in the admin workspace.
VALUATION_MODEL_METRICS_PATH=data/valuation_model_metrics.json

# Synthetic demonstration dataset. Regenerable, not real market data.
VALUATION_DATASET_PATH=data/valuation_demo_dataset.csv


# -----------------------------------------------------------------------------
# Advanced
# -----------------------------------------------------------------------------
# Load configuration from a different file instead of backend/.env.
# Useful when several deployments share one checkout.
# SMARTCYCLE_ENV_FILE=/etc/smartcycle/backend.env
