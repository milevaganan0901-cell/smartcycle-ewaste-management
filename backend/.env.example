# =============================================================================
# SmartCycle backend configuration
#
#   cp .env.example .env
#
# then fill in the values marked REQUIRED and start the server. This file is
# loaded automatically at startup. Real environment variables always win over
# anything set here, so a container or process manager can override any value
# without editing a file.
#
# NEVER commit a real .env. This example contains placeholders only.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED - authentication
# -----------------------------------------------------------------------------
# Secret used to sign JWT access tokens. There is no default and no fallback:
# the API starts without it but refuses to issue or accept any token (503),
# and logs a warning at startup.
#
# Generate one for local development:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# In production, supply this from a secret manager - never a file in the repo.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Access-token lifetime in minutes. Default 480 (8 hours).
# Production should use a much shorter value once refresh tokens exist.
ACCESS_TOKEN_EXPIRE_MINUTES=480


# -----------------------------------------------------------------------------
# CORS - local development needs nothing here
# -----------------------------------------------------------------------------
# Local frontend origins (http://localhost:5173 and http://127.0.0.1:5173) are
# built into the application already, so a fresh clone works with no CORS
# configuration. These two variables only matter for a real deployment.
#
# The allowlist is always explicit. A wildcard is never used, because the API
# sends credentials and browsers reject "*" alongside credentials anyway.
#
# PRODUCTION: set the deployed frontend origin here, including the scheme.
#   CORS_ORIGIN_PRODUCTION=https://your-frontend.example.com
CORS_ORIGIN_PRODUCTION=

# Optional override of the whole allowlist. Comma-separated, no wildcards.
# Setting this REPLACES the built-in development origins, so include the dev
# origins above too if you still want local development to work.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# -----------------------------------------------------------------------------
# DATABASE - SQLite, and the path is resolved reliably
# -----------------------------------------------------------------------------
# Just the SQLite file. Relative paths are resolved against the backend/
# directory, NOT the process working directory, so the same file is used
# however the server is launched.
DATABASE_PATH=smartcycle.db

# Optional full SQLAlchemy URL, for an absolute path or a future non-SQLite
# backend. Takes precedence over DATABASE_PATH. Relative sqlite:/// URLs are
# also anchored to backend/ so they cannot silently point at a different file.
# DATABASE_URL=sqlite:////absolute/path/to/smartcycle.db

# PRODUCTION NOTE: SQLite is a single-writer, file-based database. It is not
# suitable for multiple application instances, most container platforms with
# ephemeral filesystems, or serverless deployments. See the "Deployment
# Preparation" section of the README before deploying.


# -----------------------------------------------------------------------------
# ML VALUATION - all optional, the app runs without any of them
# -----------------------------------------------------------------------------
# Directory holding the dataset, the trained pipeline and its metrics.
# Relative paths are resolved against backend/.
SMARTCYCLE_DATA_DIR=data

# Trained scikit-learn pipeline, produced by the MANUAL step:
#   python -m app.scripts.train_valuation_model
# The model is never retrained automatically, on startup or on request.
# If this file is missing or unreadable the API silently falls back to the
# rule-based estimator and labels the result "rule_based".
VALUATION_MODEL_PATH=data/valuation_model.joblib

# Metrics sidecar written by the training script, shown in the admin workspace.
VALUATION_MODEL_METRICS_PATH=data/valuation_model_metrics.json

# Synthetic demonstration dataset. Regenerable, not real market data.
VALUATION_DATASET_PATH=data/valuation_demo_dataset.csv


# -----------------------------------------------------------------------------
# Advanced
# -----------------------------------------------------------------------------
# Load configuration from a different file instead of backend/.env.
# Useful when several deployments share one checkout.
# SMARTCYCLE_ENV_FILE=/etc/smartcycle/backend.env
